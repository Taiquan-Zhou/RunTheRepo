let language = 'zh';
let currentDoctor = null;
let currentDoctorError = null;
let startupReady = startupReport?.ready === true;
let currentStatus = null;
let currentStatusExplicitUnknown = false;
let currentFormError = null;
let submissionUnknownActive = false;
