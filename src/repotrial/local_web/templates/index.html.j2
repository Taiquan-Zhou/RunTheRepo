<dialog id="guide-dialog" aria-labelledby="guide-title"><div class="card-header"><h2 id="guide-title" data-i18n="guide.title">配置填写指南</h2><button class="btn secondary" id="close-guide" type="button" data-i18n="actions.close">关闭</button></div><p data-i18n="guide.intro">先确认仓库版本与应用端口。没有特殊需求时，可以先留空高级选项。</p><nav><a href="#guide-sha" data-i18n="guide.navSha">Commit SHA</a><a href="#guide-port" data-i18n="guide.navPort">容器端口</a><a href="#guide-compose" data-i18n="guide.navCompose">Compose 路径</a><a href="#guide-endpoint" data-i18n="guide.navEndpoint">Endpoint</a><a href="#guide-model" data-i18n="guide.navModel">模型名称</a></nav><article id="guide-sha" tabindex="-1"><h3 data-i18n="guide.shaTitle">Commit SHA · 固定检查哪个版本</h3><p data-i18n="guide.shaBody">填入目标仓库的完整 40 位小写提交哈希。</p></article><article id="guide-port" tabindex="-1"><h3 data-i18n="guide.portTitle">应用容器端口 · 应用在容器里监听哪里</h3><p data-i18n="guide.portBody">填写 Web 应用在容器内部监听的端口。</p></article><article id="guide-compose" tabindex="-1"><h3 data-i18n="guide.composeTitle">Compose 相对路径 · 指定部署文件</h3><p data-i18n="guide.composeBody">相对于目标仓库根目录填写。</p></article><article id="guide-endpoint" tabindex="-1"><h3 data-i18n="guide.endpointTitle">模型 Endpoint · 模型服务地址</h3><p data-i18n="guide.endpointBody">使用模型服务提供的 HTTP(S) API 基础地址。</p></article><article id="guide-model" tabindex="-1"><h3 data-i18n="guide.modelTitle">模型名称 · 服务端接受的模型 ID</h3><p data-i18n="guide.modelBody">填写对应 Endpoint 实际支持的模型 ID。</p></article></dialog><script>
const token = document.querySelector('meta[name="csrf-token"]').content;
const startupReport = {{ startup_report | tojson }};
const form = document.querySelector('#trial-form');
const submitButton = document.querySelector('#submit-button');
const formErrors = document.querySelector('#form-errors');
const repositoryUrl = document.querySelector('#url');
const commitShaInput = document.querySelector('#commit_sha');
const commitLink = document.querySelector('#commit-link');
const commitSource = document.querySelector('#commit-source');
const containerPortInput = document.querySelector('#container_port');
const portSource = document.querySelector('#port-source');
const portOptions = document.querySelector('#port-options');
const composePathInput = document.querySelector('#compose_path');
const composeOptions = document.querySelector('#compose-options');
const modelEndpointInput = document.querySelector('#model_endpoint');
const modelNameInput = document.querySelector('#model_name');
const modelNameOptions = document.querySelector('#model-name-options');
const modelNameToggle = document.querySelector('#model-name-toggle');
const modelApiKeyInput = document.querySelector('#model_api_key');
const modelSettingsError = document.querySelector('#model-settings-error');
const saveModelSettingsButton = document.querySelector('#save-model-settings');
const clearModelSettingsButton = document.querySelector('#clear-model-settings');
const discoverModelsButton = document.querySelector('#discover-models');
const repositoryMetaStatus = document.querySelector('#repository-meta-status');
const detectRepositoryButton = document.querySelector('#detect-repository');
const environment = document.querySelector('#environment');
const environmentStateBadge = document.querySelector('#environment-state-badge');
function updateEnvironmentBadge(state) {
  const labels = { zh: { idle: '未检查', checking: '检查中', ready: 'Ready', error: '需处理' }, en: { idle: 'Not checked', checking: 'Checking', ready: 'Ready', error: 'Needs attention' } };
  environmentStateBadge.textContent = (labels[language] || labels.zh)[state] || labels.zh.idle;
}
const factRepository = document.querySelector('#fact-repository');
const factSha = document.querySelector('#fact-sha');
const factPort = document.querySelector('#fact-port');
const factCompose = document.querySelector('#fact-compose');
const headerRepository = document.querySelector('#header-repository');
const factStates = [...document.querySelectorAll('#fact-strip .fact-state')];
const sidebarNavItems = [...document.querySelectorAll('#production-sidebar nav a')];
function syncFactStrip() {
  const url = repositoryUrl.value.trim();
  const verified = Boolean(currentRepositoryMetadata);
  const labels = language === 'en'
    ? { identified: 'Identified', pinned: 'Pinned', configured: 'Configured', found: 'Found', filled: 'Filled' }
    : { identified: '已识别', pinned: '已固定', configured: '已配置', found: '已找到', filled: '已填写' };
  const pending = language === 'en'
    ? ['Awaiting', 'Not pinned', 'Not configured', 'Not found']
    : ['待确认', '待固定', '待配置', '待找到'];
  const repository = url.replace(/^https?:\/\/github\.com\//, '');
  factRepository.textContent = repository || (language === 'en' ? 'Not entered' : '未填写');
  factStates[0].textContent = repository ? (verified ? labels.identified : labels.filled) : pending[0];
  headerRepository.textContent = repository || (language === 'en' ? 'Not selected' : '未选择');
  const sha = commitShaInput.value.trim();
  factSha.textContent = sha ? sha.slice(0, 12) + '…' : (language === 'en' ? 'Not entered' : '未填写');
  factStates[1].textContent = sha ? (verified && Boolean(commitSource.textContent) ? labels.pinned : labels.filled) : pending[1];
  const emptySha = language === 'en' ? 'Not entered' : '未填写';
  factSha.title = sha || emptySha;
  factSha.setAttribute('aria-label', sha || emptySha);
  const port = containerPortInput.value.trim();
  factPort.textContent = port || (language === 'en' ? 'Not entered' : '未填写');
  factStates[2].textContent = port ? (verified && Boolean(portSource.textContent) ? labels.configured : labels.filled) : pending[2];
  const compose = composePathInput.value.trim();
  factCompose.textContent = compose || (language === 'en' ? 'Auto-detect' : '自动识别');
  factStates[3].textContent = compose ? (verified && !composeManuallyEdited ? labels.found : labels.filled) : pending[3];
}


const doctorButton = document.querySelector('#doctor');
const statusTitle = document.querySelector('#status-title');
const statusDesc = document.querySelector('#status-desc');
const stateDot = document.querySelector('#state-dot');
const elapsed = document.querySelector('#elapsed');
const exitCode = document.querySelector('#exit');
const reason = document.querySelector('#reason');
const reportDesc = document.querySelector('#report-desc');
const reports = document.querySelector('#reports');
const htmlReport = document.querySelector('#html-report');
const jsonReport = document.querySelector('#json-report');
const reportCard = document.querySelector('#report-card');
const phaseProgress = document.querySelector('#phase-progress');
const phaseList = document.querySelector('#phase-list');
const phaseProgressUnavailable = document.querySelector('#phase-progress-unavailable');
const retryButton = document.querySelector('#retry-button');
const stopButton = document.querySelector('#stop-button');
const newInspectionButton = document.querySelector('#new-inspection-button');
const runSummary = document.querySelector('#run-summary');
const introTitle = document.querySelector('#intro-title');
const introDescription = document.querySelector('#intro-description');
const workspaceFlow = document.querySelector('#workspace-flow');
const flowSteps = [...document.querySelectorAll('#workspace-flow .flow-step')];

function syncSidebarNavigation(state) {
  const terminal = ['completed', 'failed', 'unknown'].includes(state);
  const hasReport = !reportCard.hidden && (!htmlReport.hidden || !jsonReport.hidden);
  const index = ['submitting', 'running'].includes(state) ? 1 : terminal && hasReport ? 2 : terminal ? 1 : 0;
  sidebarNavItems.forEach((item, itemIndex) => {
    const active = itemIndex === index;
    const accessible = active || (terminal && itemIndex < 2) || (itemIndex === 0 && terminal);
    if (active) item.setAttribute('aria-current', 'page');
    else item.removeAttribute('aria-current');
    item.setAttribute('aria-disabled', accessible ? 'false' : 'true');
    item.tabIndex = accessible ? 0 : -1;
  });
}

function setWorkspaceFlow(state) {
  const current = ['submitting', 'running'].includes(state)
    ? 'run'
    : ['completed', 'failed', 'unknown'].includes(state)
      ? 'evidence'
      : 'repository';
  const order = ['repository', 'run', 'evidence'];
  flowSteps.forEach((step) => {
    const index = order.indexOf(step.dataset.flow);
    const currentIndex = order.indexOf(current);
    step.classList.toggle('is-done', index < currentIndex);
    if (index === currentIndex) {
      step.setAttribute('aria-current', 'step');
    } else {
      step.removeAttribute('aria-current');
    }
  });
  workspaceFlow.dataset.flowState = state;
}

function setWorkspaceState(state) {
  document.body.dataset.consoleState = state;
  setWorkspaceFlow(state);
  syncSidebarNavigation(state);
  const active = state === 'running' || state === 'submitting';
  if (state === 'submitting') {
    statusTitle.textContent = t('task.submitting');
    statusDesc.textContent = t('task.submittingDescription');
  }
  retryButton.disabled = active || !rerunRequestSnapshot;
  newInspectionButton.disabled = active;
  if (typeof updateRunActions === 'function') updateRunActions();
  const intro = translationValue('intro.states.' + state) || translationValue('intro.states.idle');
  introTitle.textContent = intro.title;
  introDescription.textContent = intro.description;
}

function updateRunActions() {
  const locked = jobActive || submitting || submissionUnknownActive
    || ['submitting', 'running'].includes(document.body.dataset.consoleState);
  retryButton.disabled = locked || !rerunRequestSnapshot;
  stopButton.disabled = !jobActive || submitting || stopInFlight
    || currentStatus?.control === 'stopping'
    || currentStatus?.control === 'stopped'
    || document.body.dataset.consoleState !== 'running';
  newInspectionButton.disabled = locked;
}

function updateRunSummary() {
  const rawUrl = repositoryUrl.value.trim();
  runSummary.replaceChildren();
  if (recoverySummary && !rawUrl) {
    const name = document.createElement('strong');
    name.textContent = t('task.restoreSummary');
    const detail = document.createElement('span');
    detail.textContent = t('task.restoreSummaryDetail');
    runSummary.append(name, detail);
    return;
  }
  let repository = rawUrl;
  try {
    const parsed = new URL(rawUrl);
    repository = parsed.pathname.replace(/^\//, '').replace(/\.git$/, '') || rawUrl;
  } catch {
    repository = rawUrl;
  }
  const name = document.createElement('strong');
  name.textContent = repository;
  const metadata = document.createElement('span');
  const sha = commitShaInput.value.trim();
  const compose = composePathInput.value.trim();
  metadata.textContent = (sha ? sha.slice(0, 7) : '—') + ' · :' + (containerPortInput.value.trim() || '—') + (compose ? ' · ' + compose : '');
  runSummary.append(name, metadata);
}


const latestEvidence = document.querySelector('#latest-evidence');
const headers = { 'Content-Type': 'application/json', 'X-CSRF-Token': token };
const storageKey = 'repotrial-active-job-id';
const jobIdPattern = /^[0-9a-f-]{36}$/i;

const languageStorageKey = 'repotrial-language';
const languageSelect = document.querySelector('#language-select');
const translations = {
  zh: {
    title: 'RunTheRepo · 本地控制台',
    brand: { localConsole: 'LOCAL CONSOLE' },
    header: { localTask: '本机 · 单任务', userGuide: '使用文档 ↗', currentRepository: '当前仓库' },
    language: { label: '语言' },
    nav: { label: '检查导航', new: '新建检查', current: '当前任务', result: '结果与证据', help: '帮助', aria: '检查导航' },
    flow: { repository: '仓库', run: '运行', evidence: '证据' },
    intro: {
      eyebrow: '仓库检查工作台',
      title: '新建检查',
      description: '在一次性隔离环境中运行应用，用可复现的证据查看结果。',
