let autoComposePath = '';
let autoContainerPort = '';
let commitManuallyEdited = false;
let composeManuallyEdited = false;
let portManuallyEdited = false;
let portSelectedFromDiscovery = false;

function translationValue(key) {
  return key.split('.').reduce(
    (current, part) => current?.[part],
    translations[language],
  );
}

function t(key, values = {}) {
  const value = translationValue(key);
  if (typeof value !== 'string') {
    return key;
  }
  return value.replace(/\{(\w+)\}/g, (_, name) => String(values[name] ?? ''));
}

function readLanguage() {
  try {
    const stored = localStorage.getItem(languageStorageKey);
    return stored === 'en' || stored === 'zh' ? stored : 'zh';
  } catch {
    return 'zh';
  }
}

function rememberLanguage() {
  try {
    localStorage.setItem(languageStorageKey, language);
  } catch {
    // A restricted browser may reject preferences without affecting the console.
  }
}

let activeJobId = null;
let lastProgressJobId = null;
let lastConfirmedProgress = null;
let pollTimer = null;
let pollInFlight = false;
let stopInFlight = false;
let rerunRequestSnapshot = null;
let submitting = false;
let jobActive = false;
let doctorRunning = false;
let elapsedTicker = null;
let elapsedServerSeconds = null;
let elapsedAnchorAt = null;
let elapsedRenderedSeconds = null;
let elapsedNeedsSync = false;
let recoverySummary = false;

function stopPolling() {
  if (pollTimer !== null) {
    clearTimeout(pollTimer);
    pollTimer = null;
  }
}

function resetInspection() {
  stopPolling();
  activeJobId = null;
  currentStatus = null;
  currentStatusExplicitUnknown = false;
  submissionUnknownActive = false;
  recoverySummary = false;
  lastProgressJobId = null;
  lastConfirmedProgress = null;
  forgetStoredJobId();
  invalidateMetadataRequest();
  if (metadataTimer !== null) {
    clearTimeout(metadataTimer);
    metadataTimer = null;
  }
  currentRepositoryMetadata = null;
  metadataRequestKey = '';
  lastMetadataRequestKey = '';
  metadataCooldownUntil = 0;
  autoComposePath = '';
  commitManuallyEdited = false;
  composeManuallyEdited = false;
  portManuallyEdited = false;
  portSelectedFromDiscovery = false;
  clearDiscoveryFields();
  clearReports();
  setBusy(false);
  setWorkspaceState('idle');
}

function clearReports() {
  reportCard.hidden = true;
  htmlReport.hidden = true;
  htmlReport.removeAttribute('href');
  jsonReport.hidden = true;
  jsonReport.removeAttribute('href');
  reports.textContent = '';
  reportDesc.textContent = t('report.description');
}

function updateBusyUi() {
  const busy = jobActive || doctorRunning;
  for (const element of form.elements) {
    element.disabled = busy;
  }
  doctorButton.disabled = busy;
  submitButton.disabled = busy || !startupReady;
  detectRepositoryButton.disabled = busy || metadataRequestInFlight;
  submitButton.textContent = jobActive ? t('task.submitting') : t('actions.start');
  if (typeof updateRunActions === 'function') updateRunActions();
}

function setBusy(busy) {
  jobActive = busy;
  updateBusyUi();
}

function formatElapsed(seconds) {
  if (typeof seconds !== 'number' || !Number.isFinite(seconds)) {
    return '—';
  }
  return seconds < 60
    ? t('time.seconds', { value: Math.floor(seconds) })
    : t('time.minutes', {
        minutes: Math.floor(seconds / 60),
        seconds: Math.floor(seconds % 60),
      });
}

function stopElapsedTicker({ reset = false } = {}) {
  if (elapsedTicker !== null) {
    clearInterval(elapsedTicker);
    elapsedTicker = null;
  }
  elapsedAnchorAt = null;
  if (reset) {
    elapsedServerSeconds = null;
    elapsedAnchorAt = null;
    elapsedRenderedSeconds = null;
    elapsedNeedsSync = false;
    elapsed.textContent = '—';
  }
}

function renderElapsedClock() {
  if (
    typeof elapsedServerSeconds !== 'number'
    || !Number.isFinite(elapsedServerSeconds)
  ) {
    return;
  }
  const now = performance.now();
  const clientElapsed = elapsedAnchorAt === null
    ? elapsedServerSeconds
    : elapsedServerSeconds + Math.max(0, (now - elapsedAnchorAt) / 1000);
  const next = Math.max(elapsedRenderedSeconds ?? 0, clientElapsed);
  elapsedRenderedSeconds = next;
  elapsed.textContent = formatElapsed(next);
}

function anchorElapsed(serverSeconds, { running = false } = {}) {
  if (typeof serverSeconds === 'number' && Number.isFinite(serverSeconds)) {
    const previous = elapsedRenderedSeconds ?? elapsedServerSeconds ?? 0;
    elapsedServerSeconds = Math.max(previous, serverSeconds);
    elapsedAnchorAt = performance.now();
    elapsedNeedsSync = false;
  } else if (running) {
    elapsedNeedsSync = true;
  }
  renderElapsedClock();
  if (running && elapsedTicker === null) {
    elapsedTicker = setInterval(renderElapsedClock, 250);
  }
}

function validRepositoryUrl(value) {
  try {
    const parsed = new URL(value);
    return parsed.protocol === 'https:'
      && parsed.hostname.toLowerCase() === 'github.com'
      && /^\/[^/\s]+\/[^/\s?#]+\/?$/.test(parsed.pathname);
  } catch {
    return false;
  }
}

function clearDiscoveryFields() {
  commitLink.hidden = true;
  commitLink.removeAttribute('href');
  commitSource.textContent = '';
  portOptions.replaceChildren();
  portOptions.hidden = true;
  portSource.textContent = '';
  composeOptions.replaceChildren();
  composeOptions.hidden = true;
  if (!commitManuallyEdited && commitShaInput.value === autoCommitSha) {
    commitShaInput.value = '';
  }
  if (
    !portManuallyEdited
    && (portSelectedFromDiscovery || containerPortInput.value === autoContainerPort)
  ) {
    containerPortInput.value = '';
  }
  if (!composeManuallyEdited && composePathInput.value === autoComposePath) {
    composePathInput.value = '';
  }
  autoCommitSha = '';
  autoContainerPort = '';
  portSelectedFromDiscovery = false;
  autoComposePath = '';
  currentRepositoryMetadata = null;
  setMetadataStatus('');
  renderManualCommitLink();
}

function setMetadataStatus(key) {
  repositoryMetaStatus.textContent = key ? t(key) : '';
}

function renderMetadataCooldown() {
  if (metadataCooldownUntil <= Date.now()) {
    return false;
  }
  const time = new Date(metadataCooldownUntil).toLocaleTimeString(
    language === 'en' ? 'en-US' : 'zh-CN',
    { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false },
  );
  repositoryMetaStatus.textContent = t('errors.metadataCooldown', { time });
  return true;
}

function safeCommitUrl(value, repository, sha) {
  try {
    const parsed = new URL(value || (repository + '/commit/' + sha));
    if (
      parsed.protocol !== 'https:'
      || parsed.hostname.toLowerCase() !== 'github.com'
      || !/\/commit\/[0-9a-f]{40}$/i.test(parsed.pathname)
    ) {
      return null;
    }
    return parsed.href;
  } catch {
    return null;
  }
}

function renderManualCommitLink() {
  const url = repositoryUrl.value.trim();
  const sha = commitShaInput.value.trim().toLowerCase();
  const link = validRepositoryUrl(url) && /^[0-9a-f]{40}$/.test(sha)
    ? safeCommitUrl(null, url, sha)
    : null;
  if (!link) {
    commitLink.hidden = true;
    commitLink.removeAttribute('href');
    if (commitManuallyEdited) {
      commitSource.textContent = '';
    }
    return;
  }
  commitLink.href = link;
  commitLink.textContent = t('errors.commitLink');
  commitLink.hidden = false;
  commitSource.textContent = t('errors.commitManual');
}

function renderRepositoryMetadata(metadata) {
  currentRepositoryMetadata = metadata;
  if (!metadata || typeof metadata !== 'object') {
    return;
  }
  const url = repositoryUrl.value.trim();
  const sha = typeof metadata.commit_sha === 'string'
    ? metadata.commit_sha.toLowerCase()
    : '';
  if (/^[0-9a-f]{40}$/.test(sha)) {
    const link = safeCommitUrl(metadata.commit_url, url, sha);
    if (link) {
      commitLink.href = link;
      commitLink.textContent = t('errors.commitLink');
      commitLink.hidden = false;
      commitSource.textContent = commitShaInput.value === sha
        ? t(commitManuallyEdited ? 'errors.commitManual' : 'errors.commitAuto')
        : '';
    }
    if (!commitManuallyEdited && (!commitShaInput.value || commitShaInput.value === autoCommitSha)) {
      commitShaInput.value = sha;
      autoCommitSha = sha;
      commitSource.textContent = t('errors.commitAuto');
    }
  }

  const composeCandidates = Array.isArray(metadata.compose_candidates)
    ? metadata.compose_candidates.filter((value) => typeof value === 'string' && value)
    : [];
  const selectedCompose = typeof metadata.selected_compose_path === 'string'
    ? metadata.selected_compose_path
    : '';
  if (composeCandidates.length > 1) {
    composeOptions.replaceChildren();
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = t('errors.composeCandidates');
    composeOptions.append(placeholder);
    for (const candidate of composeCandidates) {
      const option = document.createElement('option');
      option.value = candidate;
      option.textContent = candidate;
      composeOptions.append(option);
    }
    composeOptions.hidden = false;
    if (selectedCompose && !composeManuallyEdited) {
      composeOptions.value = selectedCompose;
      composePathInput.value = selectedCompose;
      autoComposePath = selectedCompose;
    }
  } else if (composeCandidates.length === 1 && !composeManuallyEdited) {
    composePathInput.value = selectedCompose || composeCandidates[0];
    autoComposePath = composePathInput.value;
  } else if (selectedCompose && !composeManuallyEdited && !composePathInput.value) {
    composePathInput.value = selectedCompose;
    autoComposePath = selectedCompose;
  }

  const ports = Array.isArray(metadata.ports)
    ? metadata.ports.filter((item) => (
      item && Number.isInteger(item.port) && item.port >= 1 && item.port <= 65535
    ))
    : [];
  if (ports.length === 1 && !portManuallyEdited) {
    portOptions.replaceChildren();
    portOptions.hidden = true;
    containerPortInput.value = String(ports[0].port);
    autoContainerPort = containerPortInput.value;
    portSelectedFromDiscovery = false;
    portSource.textContent = typeof ports[0].service === 'string' && ports[0].service
      ? ' · ' + ports[0].service
      : '';
  } else if (ports.length > 1) {
    portOptions.replaceChildren();
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = t('errors.portCandidates');
    portOptions.append(placeholder);
    for (const item of ports) {
      const option = document.createElement('option');
      option.value = String(item.port);
      const service = typeof item.service === 'string' && item.service
        ? item.service + ' · '
        : '';
      option.textContent = service + item.port;
      portOptions.append(option);
    }
    portOptions.hidden = false;
    portSource.textContent = '';
    if (
      !portManuallyEdited
      && (portSelectedFromDiscovery || containerPortInput.value === autoContainerPort)
    ) {
      containerPortInput.value = '';
      autoContainerPort = '';
    }
  } else {
    portOptions.replaceChildren();
    portOptions.hidden = true;
    portSelectedFromDiscovery = false;
    portSource.textContent = '';
  }

  const errors = Array.isArray(metadata.errors) ? metadata.errors : [];
  const warnings = Array.isArray(metadata.warnings) ? metadata.warnings : [];
  if (errors.length) {
    setMetadataStatus(metadataIssueKey(errors[0]));
  } else if (warnings.length) {
    setMetadataStatus(metadataIssueKey(warnings[0]));
  } else if (sha) {
    setMetadataStatus('errors.metadataReady');
  } else if (!ports.length) {
    setMetadataStatus('errors.metadataNoPort');
  }
  syncFactStrip();
}

function metadataIssueKey(value) {
  const code = String(value || '').toLowerCase();
  if (code.includes('git_metadata_fallback')) {
    return 'errors.metadataGitFallback';
  }
  if (code.includes('git_timeout')) {
    return 'errors.metadataGitTimeout';
  }
  if (code.includes('git_unavailable')) {
    return 'errors.metadataGitUnavailable';
  }
  if (code.includes('git_metadata_limit_exceeded')) {
    return 'errors.metadataGitLimit';
  }
  if (code.includes('archive_limit_exceeded')) {
    return 'errors.metadataArchiveLimit';
  }
  if (code.includes('git_compose_selection_required')) {
    return 'errors.metadataGitComposeSelection';
  }
  if (code.includes('git_ls_remote_failed')) {
    return 'errors.metadataGitLsRemoteFailed';
  }
  if (code.includes('git_archive_redirect_rejected')) {
    return 'errors.metadataGitArchiveRedirect';
  }
  if (code.includes('git_archive_invalid')) {
    return 'errors.metadataGitArchiveInvalid';
  }
  if (code.includes('git_archive_failed')) {
    return 'errors.metadataGitArchiveFailed';
  }
  if (code.includes('git_commit_not_found')) {
    return 'errors.metadataGitCommitNotFound';
  }
  if (code.includes('git_compose_not_found')) {
    return 'errors.metadataGitComposeNotFound';
  }
  if (code.includes('rate_limit')) {
    return 'errors.metadataRateLimited';
  }
  if (code.includes('github_forbidden')) {
    return 'errors.metadataForbidden';
  }
  if (code.includes('github_timeout')) {
    return 'errors.metadataTimeout';
  }
  if (code.includes('compose_not_found')) {
    return 'errors.metadataNoCompose';
  }
  if (code.includes('no_port') || code.includes('port_unresolved')) {
    return 'errors.metadataNoPort';
  }
  if (code.includes('tree_truncated')) {
    return 'errors.metadataTruncated';
  }
  if (code.includes('multiple')) {
    return 'errors.metadataMultiple';
  }
  if (code.includes('not_found') || code === 'not_found') {
    return 'errors.metadataNotFound';
  }
  if (code.includes('port')) {
    return 'errors.metadataNoPort';
  }
  return 'errors.metadataFailed';
}

function repositoryMetadataKey(url = repositoryUrl.value.trim()) {
  return [url, commitShaInput.value.trim(), composePathInput.value.trim()].join('|');
}

function invalidateMetadataRequest() {
  metadataSequence += 1;
  metadataRequestKey = '';
  metadataRequestInFlight = false;
  updateBusyUi();
}

function scheduleRepositoryDiscovery(delay = 600) {
  if (metadataTimer !== null) {
    clearTimeout(metadataTimer);
  }
  if (renderMetadataCooldown()) {
    return;
  }
  metadataTimer = setTimeout(() => {
    metadataTimer = null;
    void discoverRepository();
  }, delay);
}

async function discoverRepository({ force = false } = {}) {
  const url = repositoryUrl.value.trim();
  if (!validRepositoryUrl(url) || jobActive || doctorRunning) {
    return;
  }
  if (renderMetadataCooldown()) {
    return;
  }
  const requestKey = repositoryMetadataKey(url);
  if (!force && (
    requestKey === metadataRequestKey
    || (requestKey === lastMetadataRequestKey && currentRepositoryMetadata)
  )) {
    return;
  }
  const sequence = ++metadataSequence;
  metadataRequestKey = requestKey;
  metadataRequestInFlight = true;
  updateBusyUi();
  setMetadataStatus('errors.metadataRunning');
  const payload = { url };
  const sha = commitShaInput.value.trim();
  const composePath = composePathInput.value.trim();
  if (/^[0-9a-f]{40}$/.test(sha)) {
    payload.commit_sha = sha;
  }
  if (composePath) {
    payload.compose_path = composePath;
  }
  try {
    const metadata = await requestJson('/api/repository', {
      method: 'POST',
      headers,
      body: JSON.stringify(payload),
    });
    if (sequence !== metadataSequence || repositoryUrl.value.trim() !== url) {
      return;
    }
    const retryAfter = Number(metadata?.retry_after_seconds);
    if (Number.isFinite(retryAfter) && retryAfter > 0) {
      metadataCooldownUntil = Date.now() + retryAfter * 1000;
    }
    lastMetadataRequestKey = requestKey;
    renderRepositoryMetadata(metadata);
    renderMetadataCooldown();
  } catch {
    if (sequence === metadataSequence && repositoryUrl.value.trim() === url) {
      setMetadataStatus('errors.metadataFailed');
    }
  } finally {
    if (sequence === metadataSequence) {
      metadataRequestKey = '';
      metadataRequestInFlight = false;
      updateBusyUi();
    }
  }
}

function validationMessage(detail) {
  if (!Array.isArray(detail)) {
    return typeof detail === 'string'
      ? detail
      : t('errors.invalidRequest');
  }
  return detail
    .map((item) => {
      const location = Array.isArray(item?.loc)
        ? item.loc[item.loc.length - 1]
        : t('errors.field');
      return location + '：' + (item?.msg || t('errors.invalidField'));
    })
    .join('\n');
}

function submissionUnknown(message) {
  const error = new Error(message);
  error.submissionUnknown = true;
  return error;
}

function localizedError(key) {
  const error = new Error(t(key));
  error.i18nKey = key;
  return error;
}

async function requestJson(url, options) {
  let response;
  try {
    response = await fetch(url, options);
  } catch {
    throw localizedError('errors.network');
  }

  let body;
  try {
    body = await response.json();
  } catch {
    if (response.ok) {
      throw new Error(t('errors.missingJobId'));
    }
    const error = localizedError('errors.invalidResponse');
    error.httpStatus = response.status;
    throw error;
  }

  if (!response.ok) {
    const error = body?.detail === undefined
      ? localizedError('errors.invalidRequest')
      : new Error(validationMessage(body.detail));
    error.httpStatus = response.status;
    throw error;
  }
  return body;
}

function setModelSettingsError(message = '') {
  modelSettingsError.textContent = message;
}

let discoveredModels = [];
let modelMenuOpen = false;
let modelActiveIndex = -1;
let modelFetched = false;

function resetModelOptions() {
  discoveredModels = [];
  modelFetched = false;
  modelActiveIndex = -1;
  modelNameOptions.replaceChildren();
  closeModelMenu();
}

function renderModelOptions(filter = '') {
  const normalized = filter.trim().toLowerCase();
  const matches = normalized
    ? discoveredModels.filter((model) => model.toLowerCase().includes(normalized))
    : discoveredModels;
  modelNameOptions.replaceChildren();
  for (const [index, model] of matches.entries()) {
    const option = document.createElement('div');
    option.className = 'model-option';
    option.id = `model-option-${index}`;
    option.setAttribute('role', 'option');
    option.setAttribute('aria-selected', String(index === modelActiveIndex));
    option.textContent = model;
    option.addEventListener('mousedown', (event) => event.preventDefault());
    option.addEventListener('click', () => selectModelOption(model));
    modelNameOptions.append(option);
  }
  if (!matches.length) {
    const empty = document.createElement('div');
    empty.className = 'model-listbox-empty';
    empty.textContent = modelFetched ? t('fields.modelOptionsEmpty') : t('fields.modelOptionsPlaceholder');
    modelNameOptions.append(empty);
  }
}

function openModelMenu({ filter = '' } = {}) {
  modelMenuOpen = true;
  modelNameInput.setAttribute('aria-expanded', 'true');
  renderModelOptions(filter);
  modelNameOptions.hidden = false;
}

function closeModelMenu() {
  modelMenuOpen = false;
  modelActiveIndex = -1;
  modelNameInput.setAttribute('aria-expanded', 'false');
  modelNameOptions.hidden = true;
}

function selectModelOption(model) {
  modelNameInput.value = model;
  closeModelMenu();
}

function moveModelActive(step) {
  const options = [...modelNameOptions.querySelectorAll('[role="option"]')];
  if (!options.length) return;
  modelActiveIndex = (modelActiveIndex + step + options.length) % options.length;
  options.forEach((option, index) => option.setAttribute('aria-selected', String(index === modelActiveIndex)));
  options[modelActiveIndex].scrollIntoView({ block: 'nearest' });
}

function populateModelOptions(models) {
  discoveredModels = models.filter((model) => typeof model === 'string' && model);
  modelFetched = true;
  closeModelMenu();
}

let modelDiscoverySequence = 0;
let modelDiscoveryBusyRequestId = 0;

function normalizeModelEndpoint(value) {
  return value.trim().replace(/\/+$/, '');
}

function invalidateModelDiscovery() {
  modelDiscoverySequence += 1;
  resetModelOptions();
  discoverModelsButton.disabled = false;
}

function renderModelSettings(settings) {
  modelEndpointInput.value = settings?.endpoint || '';
  modelNameInput.value = settings?.model_name || '';
  modelApiKeyInput.value = '';
  resetModelOptions();
}

function refreshModelSettingsLabels() {
  if (!modelMenuOpen && !modelFetched) modelNameOptions.textContent = '';
}

async function discoverModelList() {
  const requestId = ++modelDiscoverySequence;
  modelDiscoveryBusyRequestId = requestId;
  const endpoint = normalizeModelEndpoint(modelEndpointInput.value);
  const apiKey = modelApiKeyInput.value;
  setModelSettingsError('');
  discoverModelsButton.disabled = true;
  resetModelOptions();
  try {
    const result = await requestJson('/api/settings/model/discover', {
      method: 'POST',
      headers,
      body: JSON.stringify({ endpoint, api_key: apiKey }),
    });
    if (
      requestId !== modelDiscoverySequence
      || endpoint !== normalizeModelEndpoint(modelEndpointInput.value)
      || apiKey !== modelApiKeyInput.value
    ) {
      return;
    }
    const models = Array.isArray(result?.models) ? result.models : [];
    populateModelOptions(models);
    if (models.length === 0) {
      setModelSettingsError(t('model.discoveryEmpty'));
    }
  } catch (error) {
    if (requestId === modelDiscoverySequence) {
      setModelSettingsError(error instanceof Error ? error.message : t('model.discoveryError'));
    }
  } finally {
    if (requestId === modelDiscoverySequence) {
      discoverModelsButton.disabled = false;
    }
    if (modelDiscoveryBusyRequestId === requestId) {
      modelDiscoveryBusyRequestId = 0;
      discoverModelsButton.disabled = false;
    }
  }
}

async function loadModelSettings() {
  try {
    renderModelSettings(await requestJson('/api/settings/model', { headers }));
  } catch (error) {
    setModelSettingsError(error instanceof Error ? error.message : t('model.loadError'));
  }
}

async function saveModelSettings() {
  setModelSettingsError('');
  saveModelSettingsButton.disabled = true;
  try {
    const endpoint = normalizeModelEndpoint(modelEndpointInput.value) || null;
    const modelName = modelNameInput.value.trim() || null;
    const settings = await requestJson('/api/settings/model', {
      method: 'PUT',
      headers,
      body: JSON.stringify({
        provider: endpoint || modelName ? 'custom' : null,
        endpoint,
        model_name: modelName,
        api_key: modelApiKeyInput.value,
      }),
    });
    renderModelSettings(settings);
    setModelSettingsError(t('model.saved'));
  } catch (error) {
    setModelSettingsError(error instanceof Error ? error.message : t('model.saveError'));
  } finally {
    saveModelSettingsButton.disabled = false;
  }
}

async function clearModelSettings() {
  setModelSettingsError('');
  clearModelSettingsButton.disabled = true;
  try {
    renderModelSettings(await requestJson('/api/settings/model', {
      method: 'DELETE',
      headers,
    }));
    modelEndpointInput.value = '';
    modelNameInput.value = '';
    resetModelOptions();
    setModelSettingsError(t('model.cleared'));
  } catch (error) {
    setModelSettingsError(error instanceof Error ? error.message : t('model.saveError'));
  } finally {
    clearModelSettingsButton.disabled = false;
  }
}

function rememberJobId(jobId) {
  try {
    sessionStorage.setItem(storageKey, jobId);
  } catch {
    // Querying the active job still works until this page is closed.
  }
}

function forgetStoredJobId() {
  try {
    sessionStorage.removeItem(storageKey);
  } catch {
    // Storage may be unavailable; the active in-memory state remains authoritative.
  }
}

function readStoredJobId() {
  try {
    const storedJobId = sessionStorage.getItem(storageKey);
    return storedJobId && jobIdPattern.test(storedJobId) ? storedJobId : null;
  } catch {
    return null;
  }
}

const phaseOrder = [
  'preparing_repository', 'preparing_environment', 'starting_application',
  'checking_application', 'collecting_observations', 'hardening', 'finalizing',
];

function progressTranslation(section, value) {
  const translated = translationValue('progress.' + section + '.' + value);
  return typeof translated === 'string' ? translated : '';
}

function formatEvidenceAge(seconds) {
  if (typeof seconds !== 'number' || !Number.isFinite(seconds) || seconds < 0) {
    return '';
  }
  if (seconds < 60) {
    return t('progress.ageSeconds', { value: Math.floor(seconds) });
  }
  return t('progress.ageMinutes', { value: Math.floor(seconds / 60) });
}

function renderProgress(current, state = current?.state) {
  const progress = current?.progress;
  const progressState = ['running', 'completed', 'failed', 'unknown'].includes(state)
    ? state
    : 'unknown';
  const hasActivePhase = ['running', 'failed', 'unknown'].includes(progressState);
  phaseProgress.hidden = !current;
  phaseList.replaceChildren();
  phaseProgressUnavailable.hidden = true;
  latestEvidence.hidden = true;
  if (!current) {
    return;
  }
  if (!progress || typeof progress !== 'object') {
    phaseProgressUnavailable.hidden = false;
    return;
  }
  const completed = new Set(
    Array.isArray(progress.completed_phases)
      ? progress.completed_phases.filter((value) => phaseOrder.includes(value))
      : [],
  );
  const currentPhase = phaseOrder.includes(progress.phase) ? progress.phase : '';
  if (!currentPhase && completed.size === 0 && !progress.latest_event && !progress.latest_operation) {
    phaseProgressUnavailable.hidden = false;
  }
  for (const phase of phaseOrder) {
    const item = document.createElement('li');
    const isConfirmed = completed.has(phase);
    const isCurrent = hasActivePhase && !isConfirmed && phase === currentPhase;
    item.className = isConfirmed ? 'confirmed' : isCurrent ? 'current' : '';
    item.dataset.phase = phase;
    let label = progressTranslation('phases', phase);
    if (phase === 'hardening' && Number.isInteger(progress.experiment_index)
      && progress.experiment_index > 0) {
      label = t('progress.hardeningRound', { index: progress.experiment_index });
    }
    let stateLabel = t('progress.pending');
    if (isConfirmed) {
      stateLabel = t('progress.confirmed');
    } else if (isCurrent && progressState === 'running') {
      stateLabel = t('progress.current');
    } else if (isCurrent && progressState === 'failed') {
      stateLabel = t('progress.stoppedPhase');
    } else if (isCurrent && progressState === 'unknown') {
      stateLabel = t('progress.unknownPhase');
    }
    item.textContent = label + ' · ' + stateLabel;
    phaseList.append(item);
  }

  if (!phaseList.children.length) {
    phaseProgressUnavailable.hidden = false;
  }
  const eventLabel = progressTranslation('events', progress.latest_event);
  const operationLabel = progressTranslation('operations', progress.latest_operation);
  const ageLabel = formatEvidenceAge(progress.evidence_age_seconds);
  const evidenceParts = [eventLabel, operationLabel].filter(Boolean);
  let evidenceDetail = evidenceParts.join(' · ');
  if (ageLabel) {
    evidenceDetail = evidenceDetail ? evidenceDetail + ' · ' + ageLabel : ageLabel;
  }
  latestEvidence.hidden = false;
  if (evidenceDetail) {
    latestEvidence.textContent = t('progress.latestPrefix') + evidenceDetail;
  } else if (progressState === 'failed') {
    latestEvidence.textContent = t('progress.stopped');
  } else if (progressState === 'unknown') {
    latestEvidence.textContent = t('progress.unknown');
  } else if (progressState === 'completed') {
    latestEvidence.textContent = t('progress.completed');
  } else {
    latestEvidence.textContent = t('progress.waiting');
  }
}

function isTimeBudgetExhausted(current) {
  const value = String(current?.stop_reason || current?.error || '').toLowerCase();
  return value.includes('total_duration_exhausted');
}

function renderReports(jobId, current) {
  clearReports();
  if (
    !current ||
    !['completed', 'failed'].includes(current.state) ||
    !current.reports ||
    typeof current.reports !== 'object'
  ) {
    return;
  }

  const base = '/api/jobs/' + encodeURIComponent(jobId) + '/report/';
  for (const [kind, link] of [['html', htmlReport], ['json', jsonReport]]) {
    if (Object.prototype.hasOwnProperty.call(current.reports, kind)) {
      link.href = base + kind;
      link.hidden = false;
    }
  }
  if (!htmlReport.hidden || !jsonReport.hidden) {
    reportCard.hidden = false;
    reportDesc.textContent = isTimeBudgetExhausted(current)
      ? t('report.timeBudget')
      : current.state === 'failed'
        ? t('report.failed')
      : t('report.completed');
  }
  syncSidebarNavigation(document.body.dataset.consoleState || 'idle');
}

function failureDetails(current) {
  const evidence = current?.failure_evidence && typeof current.failure_evidence === 'object'
    ? current.failure_evidence
    : {};
  const rawReason = current?.stop_reason || current?.error || '';
  const safeCode = /^[A-Za-z0-9_.-]+(?::[A-Za-z0-9_.-]+)*$/.test(rawReason)
    && rawReason.length <= 512
    ? rawReason
    : '';
  const operation = current?.failure_stage
    || evidence.operation
    || (safeCode ? safeCode.split(':')[0] : '');
  const evidenceReason = evidence.reason || '';
  const code = current?.error_code
    || safeCode
    || (operation && evidenceReason ? operation + ':' + evidenceReason : '')
    || evidenceReason
    || '';
  const searchable = (code + ' ' + rawReason).toLowerCase();
  let reasonKey = '';
  let nextKey = 'errors.genericFailureNext';
  if (searchable.includes('total_duration_exhausted')) {
    reasonKey = 'errors.timeBudgetReason';
    nextKey = 'errors.timeBudgetNext';
  } else if (searchable.includes('guest_output_malformed')) {
    reasonKey = 'errors.compatibilityMalformedReason';
    nextKey = 'errors.compatibilityMalformedNext';
  } else if (searchable.includes('preparation_timeout')) {
    reasonKey = 'errors.preparationTimeoutReason';
    nextKey = 'errors.preparationTimeoutNext';
  } else if (searchable.includes('intake:checkout_timeout')
    || searchable.includes('checkout_timeout')) {
    reasonKey = 'errors.checkoutTimeoutReason';
    nextKey = 'errors.checkoutTimeoutNext';
  } else if (searchable.includes('clone_timeout')) {
    reasonKey = 'errors.cloneTimeoutReason';
    nextKey = 'errors.cloneTimeoutNext';
  } else if (searchable.includes('sandbox') && searchable.includes('nonzero')) {
    reasonKey = 'errors.sandboxCreateReason';
    nextKey = 'errors.sandboxCreateNext';
  } else if (searchable.includes('terminal evidence unavailable')) {
    reasonKey = 'errors.terminalEvidenceReason';
    nextKey = 'errors.terminalEvidenceNext';
  } else if (searchable.includes('insufficient_coverage')) {
    reasonKey = 'errors.insufficientCoverageReason';
    nextKey = 'errors.insufficientCoverageNext';
  } else if (searchable.includes('experiment:sandbox_failed')) {
    reasonKey = 'errors.experimentSandboxFailedReason';
    nextKey = 'errors.experimentSandboxFailedNext';
  }
  return {
    stage: reasonKey === 'errors.timeBudgetReason'
      ? 'total_duration_exhausted'
      : reasonKey === 'errors.checkoutTimeoutReason'
        ? 'intake:checkout_timeout'
        : reasonKey === 'errors.preparationTimeoutReason'
          ? 'intake:preparation_timeout'
        : operation || 'unknown',
    reason: reasonKey ? t(reasonKey) : rawReason || t('errors.unknownReason'),
    next: t(nextKey),
    code: code || '—',
    runId: typeof current?.run_id === 'string' ? current.run_id : '—',
  };
}

function renderFailureDetails(current, state) {
  const visible = state === 'failed';
  const details = document.querySelector('#failure-details');
  details.hidden = !visible;
  if (!visible) {
    return;
  }
  const info = failureDetails(current);
  document.querySelector('#failure-stage').textContent = failureStageLabel(info.stage);
  document.querySelector('#failure-reason').textContent = info.reason;
  document.querySelector('#failure-next-step').textContent = info.next;
  document.querySelector('#failure-code').textContent = info.code;
  document.querySelector('#failure-run-id').textContent = info.runId;
}

function failureStageLabel(value) {
  const stage = String(value || '').toLowerCase();
  if (stage.includes('total_duration_exhausted')) {
    return t('errors.failureStageTimeBudget');
  }
  if (stage.includes('checkout_timeout') || stage.includes('preparation_timeout')) {
    return t('errors.failureStageCheckout');
  }
  if (stage.startsWith('intake') || stage.includes('clone') || stage.includes('download')) {
    return t('errors.failureStageIntake');
  }
  if (stage.includes('experiment') || stage.includes('least-privilege')) {
    return t('errors.failureStageExperiment');
  }
  if (stage.startsWith('create') || stage.includes('sandbox')) {
    return t('errors.failureStageCreate');
  }
  if (stage.includes('insufficient_coverage') || stage.includes('coverage')) {
    return t('errors.failureStageCoverage');
  }
  if (stage.startsWith('boot') || stage.includes('start')) {
    return t('errors.failureStageBoot');
  }
  if (stage.startsWith('verify') || stage.includes('journey') || stage.includes('replay')) {
    return t('errors.failureStageVerify');
  }
  if (stage === 'unknown' || !stage) {
    return t('errors.failureStageUnknown');
  }
  if (stage.startsWith('compatibility') || stage.includes('guest_output')) {
    return t('errors.failureStageCompatibility');
  }
  return value || t('errors.failureStageUnknown');
}

function requestSnapshot(value) {
  if (!value || typeof value !== 'object') return null;
  const { url, commit_sha, container_port, compose_path } = value;
  if (typeof url !== 'string' || typeof commit_sha !== 'string' || typeof container_port !== 'number') return null;
  return {
    url,
    commit_sha,
    container_port,
    ...(typeof compose_path === 'string' && compose_path ? { compose_path } : {}),
  };
}

function renderStatus(current, explicitUnknown = false, preserveElapsed = false) {
  if (
    activeJobId
    && current?.progress
    && typeof current.progress === 'object'
  ) {
    lastProgressJobId = activeJobId;
    lastConfirmedProgress = current.progress;
  }
  currentStatus = current;
  const snapshot = requestSnapshot(current?.request);
  if (snapshot) rerunRequestSnapshot = snapshot;
  currentStatusExplicitUnknown = explicitUnknown;
  submissionUnknownActive = false;
  const state = current && ['running', 'completed', 'failed', 'unknown'].includes(current.state)
    ? current.state
    : 'unknown';
  const stopped = current?.control === 'stopped';
  const visualState = stopped ? 'completed' : state;
  const timeBudgetExhausted = isTimeBudgetExhausted(current);
  setWorkspaceState(visualState);
  const statusCopy = stopped
    ? translationValue('status.stopped')
    : timeBudgetExhausted
    ? translationValue('status.timeBudgetExhausted')
    : translationValue('status.' + state);
  const color = {
    running: '#4161df',
    completed: '#178264',
    failed: '#c25353',
    unknown: '#a47126',
  }[state] || '#a47126';
  const displayColor = timeBudgetExhausted ? '#a47126' : color;

  statusTitle.textContent = statusCopy.title;
  statusDesc.textContent = statusCopy.description;
  stateDot.style.background = displayColor;
  if (state === 'running' && preserveElapsed) {
    renderElapsedClock();
    if (elapsedTicker === null) {
      elapsedTicker = setInterval(renderElapsedClock, 250);
    }
  } else if (state === 'running') {
    anchorElapsed(current?.elapsed_seconds, { running: true });
  } else if (typeof current?.elapsed_seconds === 'number') {
    stopElapsedTicker();
    elapsedServerSeconds = current.elapsed_seconds;
    elapsedRenderedSeconds = current.elapsed_seconds;
    elapsed.textContent = formatElapsed(current.elapsed_seconds);
  } else {
    elapsedNeedsSync = true;
    renderElapsedClock();
    stopElapsedTicker();
    renderElapsedClock();
  }
  exitCode.textContent = typeof current?.exit_code === 'number'
    ? current.exit_code
    : '—';
  reason.textContent = stopped
    ? (current?.stop_reason || t('status.stopped.description'))
    : timeBudgetExhausted
    ? failureDetails(current).reason
    : state === 'completed'
      ? t('task.completedReason')
      : current?.stop_reason || current?.error || (
        state === 'unknown'
          ? t('errors.unknownReason')
          : t('task.reasonInitial')
      );
  renderProgress(current, state);
  renderFailureDetails(current, state);

  renderReports(activeJobId, current);
  if (stopped || state === 'completed' || state === 'failed') {
    stopElapsedTicker();
    setBusy(false);
  } else if (state === 'unknown' && explicitUnknown) {
    stopElapsedTicker();
    activeJobId = null;
    forgetStoredJobId();
    setBusy(false);
  }
}

function renderFormError() {
  formErrors.className = currentFormError ? 'error' : '';
  formErrors.textContent = currentFormError
    ? currentFormError.translationKey
      ? t(currentFormError.translationKey)
      : currentFormError.message
    : '';
}

function showError(message) {
  const error = message instanceof Error ? message : null;
  currentFormError = {
    translationKey: error?.i18nKey || null,
    message: error?.message || String(message ?? ''),
  };
  renderFormError();
}

function clearFormError() {
  currentFormError = null;
  renderFormError();
}

function renderSubmissionUnknown() {
  setWorkspaceState('unknown');
  setBusy(true);
  introTitle.textContent = t('intro.submissionUnknownTitle');
  introDescription.textContent = t('intro.submissionUnknownDescription');
  statusTitle.textContent = t('errors.submissionTitle');
  statusDesc.textContent = t('errors.submissionDescription');
  stateDot.style.background = '#a47126';
  reason.textContent = t('errors.submissionReason');
  showError(localizedError('errors.unknownSubmission'));
}

function markSubmissionUnknown() {
  submissionUnknownActive = true;
  currentStatus = null;
  renderSubmissionUnknown();
}

function schedulePoll(delay = 500) {
  if (pollTimer !== null) {
    clearTimeout(pollTimer);
  }
  pollTimer = setTimeout(() => {
    pollTimer = null;
    void pollStatus();
  }, delay);
}

async function pollStatus() {
  if (!activeJobId || pollInFlight) {
    return;
  }
  pollInFlight = true;
  try {
    const current = await requestJson(
      '/api/jobs/' + encodeURIComponent(activeJobId),
      { headers: { Accept: 'application/json' } },
    );
    if (
      !current ||
      !['running', 'completed', 'failed', 'unknown'].includes(current.state)
    ) {
      throw new Error(t('errors.invalidState'));
    }
    renderStatus(current, current.state === 'unknown');
    if (current.state === 'running' && current.control !== 'stopped') {
      schedulePoll(1000);
    }
  } catch {
    const unknownStatus = { state: 'unknown', elapsed_seconds: null };
    if (lastProgressJobId === activeJobId && lastConfirmedProgress) {
      unknownStatus.progress = lastConfirmedProgress;
    }
    renderStatus(unknownStatus);
    reason.textContent = t('errors.pollRetry');
    schedulePoll(1000);
  } finally {
    pollInFlight = false;
  }
}

function renderDoctor(result) {
  currentDoctor = result;
  startupReady = result?.ready === true;
  currentDoctorError = null;
  environment.dataset.environmentState = startupReady ? 'ready' : 'error';
  updateEnvironmentBadge(environment.dataset.environmentState);
  environment.replaceChildren();
  const summary = document.createElement('p');
  summary.style.cssText = 'font-size:12px;margin:0 0 8px';
  summary.textContent = startupReady
    ? t('environment.ready')
    : t('environment.blocked');
  environment.append(summary);
  for (const check of Array.isArray(result.checks) ? result.checks : []) {
    const row = document.createElement('div');
    row.className = 'check';
    const name = document.createElement('span');
    name.textContent = check.name || t('environment.unnamed');
    const status = document.createElement('span');
    status.className = check.status === 'PASS' ? 'ok' : 'warn';
    status.textContent = translations[language].environment.status[check.status]
      || check.status
      || 'UNKNOWN';
    row.append(name, status);
    environment.append(row);
    if (check.status === 'FAIL' || check.status === 'UNSUPPORTED') {
      const detail = document.createElement('details');
      detail.className = 'check-detail' + (
        check.status === 'UNSUPPORTED' ? ' unsupported' : ''
      );
      detail.open = true;
      const title = document.createElement('summary');
      title.textContent = check.status === 'UNSUPPORTED'
        ? t('environment.unsupportedTitle')
        : t('environment.failTitle');
      const why = document.createElement('p');
      why.textContent = t('environment.reasonPrefix')
        + (check.detail || '');
      detail.append(title, why);
      if (check.remediation) {
        const next = document.createElement('p');
        next.textContent = t('environment.remediationPrefix')
          + check.remediation;
        detail.append(next);
      }
      environment.append(detail);
    }
  }
}

function renderDoctorError(error) {
  currentDoctor = null;
  startupReady = false;
  environment.dataset.environmentState = 'error';
  updateEnvironmentBadge('error');
  if (error && typeof error === 'object' && 'message' in error && !(error instanceof Error)) {
    currentDoctorError = error;
  } else {
    currentDoctorError = {
      key: error instanceof Error ? error.i18nKey : null,
      message: error instanceof Error ? error.message : String(error),
    };
  }
  environment.textContent = currentDoctorError.key
    ? t(currentDoctorError.key)
    : currentDoctorError.message;
}

async function runDoctor() {
  if (doctorButton.disabled || jobActive || submitting) {
    return;
  }
  doctorRunning = true;
  setWorkspaceState('environment-checking');
  environment.dataset.environmentState = 'checking';
  updateEnvironmentBadge('checking');
  updateBusyUi();
  environment.textContent = t('environment.running');
  try {
    const result = await requestJson('/api/doctor', { method: 'POST', headers });
    renderDoctor(result);
  } catch (error) {
    renderDoctorError(error instanceof Error ? error : t('environment.requestError'));
  } finally {
    doctorRunning = false;
    if (!jobActive) setWorkspaceState('idle');
    updateBusyUi();
  }
}

async function stopActiveJob() {
  if (!activeJobId || stopInFlight || document.body.dataset.consoleState !== 'running') return;
  const requestedJobId = activeJobId;
  stopInFlight = true;
  updateRunActions();
  try {
    const current = await requestJson('/api/jobs/' + encodeURIComponent(requestedJobId) + '/stop', {
      method: 'POST',
      headers,
    });
    if (activeJobId !== requestedJobId) return;
    if (current && ['running', 'completed', 'failed', 'unknown'].includes(current.state)) {
      renderStatus(current, current.state === 'unknown');
    }
    if (!current || current.state === 'running') schedulePoll(250);
  } catch (error) {
    if (activeJobId !== requestedJobId) return;
    showError(error instanceof Error ? error : localizedError('errors.stopFailed'));
    schedulePoll(250);
  } finally {
    stopInFlight = false;
    updateRunActions();
  }
}

async function submitJob(event, snapshot = null) {
  event.preventDefault();
  if (submitting || jobActive || doctorRunning) {
    return;
  }
  if (!snapshot) {
    rerunRequestSnapshot = null;
  }
  if (!startupReady) {
    showError(localizedError('errors.environmentBlocked'));
    return;
  }
  clearFormError();
  clearReports();
  submissionUnknownActive = false;
  currentStatus = null;
  activeJobId = null;
  lastProgressJobId = null;
  lastConfirmedProgress = null;
  forgetStoredJobId();
  invalidateMetadataRequest();
  if (metadataTimer !== null) {
    clearTimeout(metadataTimer);
    metadataTimer = null;
  }
  const payload = snapshot
    ? { ...snapshot }
    : Object.fromEntries(new FormData(form).entries());
  payload.container_port = Number(payload.container_port);
  if (!payload.compose_path) delete payload.compose_path;
  for (const key of ['model_endpoint', 'model_name', 'model_api_key']) {
    delete payload[key];
  }

  submitting = true;
  updateRunSummary();
  setWorkspaceState('submitting');
  setBusy(true);
  try {
    const result = await requestJson('/api/jobs', {
      method: 'POST',
      headers,
      body: JSON.stringify(payload),
    });
    if (typeof result?.job_id !== 'string' || !jobIdPattern.test(result.job_id)) {
      throw submissionUnknown(t('errors.missingJobId'));
    }
    activeJobId = result.job_id;
    rememberJobId(activeJobId);
    renderStatus({ state: 'running', elapsed_seconds: 0 });
    schedulePoll(0);
  } catch (error) {
    if (error?.submissionUnknown || typeof error?.httpStatus !== 'number') {
      markSubmissionUnknown();
    } else {
      setBusy(false);
      setWorkspaceState('idle');
      showError(error instanceof Error ? error : localizedError('errors.retrySubmit'));
    }
  } finally {
    submitting = false;
  }
}

function updateGuideLinks() {
  const guideHref = '/?view=guide&lang=' + language;
  const guide = document.querySelector('#sidebar-guide');
  if (guide) guide.href = guideHref;
  const usage = document.querySelector('#usage-guide');
  if (usage) usage.href = guideHref;
  document.querySelectorAll('[data-guide-doc]').forEach((element) => {
    const anchor = element.dataset.guideDocAnchor;
    element.href = guideHref + (anchor ? '#' + anchor : '');
  });
}

function applyLanguage() {
  document.documentElement.lang = language === 'en' ? 'en' : 'zh-CN';
  document.title = t('title');
  languageSelect.value = language;
  languageSelect.setAttribute('aria-label', t('language.label'));
  updateGuideLinks();
  document.querySelectorAll('[data-i18n]').forEach((element) => {
    element.textContent = t(element.dataset.i18n);
  });
  setWorkspaceFlow(document.body.dataset.consoleState || 'idle');
  document.querySelectorAll('[data-i18n-placeholder]').forEach((element) => {
    element.placeholder = t(element.dataset.i18nPlaceholder);
  });
  document.querySelectorAll('[data-i18n-aria-label]').forEach((element) => {
    element.setAttribute('aria-label', t(element.dataset.i18nAriaLabel));
  });
  refreshModelSettingsLabels();
  if (doctorRunning) {
    environment.textContent = t('environment.running');
  } else if (currentDoctor) {
    renderDoctor(currentDoctor);
  } else if (currentDoctorError) {
    renderDoctorError(currentDoctorError);
  }
  if (recoverySummary && !repositoryUrl.value.trim()) {
    updateRunSummary();
  }
  if (currentStatus) {
    renderStatus(currentStatus, currentStatusExplicitUnknown, true);
  } else if (submissionUnknownActive) {
    renderSubmissionUnknown();
  }
  if (currentRepositoryMetadata) {
    if (!commitLink.hidden) {
      commitLink.textContent = t('errors.commitLink');
    }
    if (commitSource.textContent) {
      commitSource.textContent = t(
        commitManuallyEdited ? 'errors.commitManual' : 'errors.commitAuto',
      );
    }
    const metadataErrors = Array.isArray(currentRepositoryMetadata.errors)
      ? currentRepositoryMetadata.errors
      : [];
    const metadataWarnings = Array.isArray(currentRepositoryMetadata.warnings)
      ? currentRepositoryMetadata.warnings
      : [];
    setMetadataStatus(
      metadataErrors.length
        ? metadataIssueKey(metadataErrors[0])
        : metadataWarnings.length
          ? metadataIssueKey(metadataWarnings[0])
          : currentRepositoryMetadata.commit_sha
            ? 'errors.metadataReady'
            : 'errors.metadataNoPort',
    );
    renderMetadataCooldown();
  }
  if (currentFormError) {
    renderFormError();
  }
  updateBusyUi();
}

languageSelect.addEventListener('change', () => {
  language = languageSelect.value === 'en' ? 'en' : 'zh';
  rememberLanguage();
  applyLanguage();
  syncFactStrip();
  updateEnvironmentBadge(environment.dataset.environmentState || 'idle');
  updateGuideLinks();
});

repositoryUrl.addEventListener('input', () => {
  recoverySummary = false;
  invalidateMetadataRequest();
  commitManuallyEdited = false;
  composeManuallyEdited = false;
  portManuallyEdited = false;
  commitShaInput.value = '';
  containerPortInput.value = '';
  composePathInput.value = '';
  clearDiscoveryFields();
  updateBusyUi();
  if (validRepositoryUrl(repositoryUrl.value.trim())) {
    scheduleRepositoryDiscovery();
  }
  syncFactStrip();
});
commitShaInput.addEventListener('input', () => {
  commitManuallyEdited = Boolean(commitShaInput.value.trim());
  invalidateMetadataRequest();
  clearDiscoveryFields();
  updateBusyUi();
  if (
    validRepositoryUrl(repositoryUrl.value.trim())
    && (!commitShaInput.value.trim() || /^[0-9a-f]{40}$/.test(commitShaInput.value.trim()))
  ) {
    scheduleRepositoryDiscovery(600);
  }
  syncFactStrip();
});
containerPortInput.addEventListener('input', () => {
  portManuallyEdited = Boolean(containerPortInput.value.trim());
  portSelectedFromDiscovery = false;
  if (portManuallyEdited) {
    portSource.textContent = '';
  } else if (validRepositoryUrl(repositoryUrl.value.trim())) {
    invalidateMetadataRequest();
    currentRepositoryMetadata = null;
    portOptions.replaceChildren();
    portOptions.hidden = true;
    scheduleRepositoryDiscovery(600);
  }
  syncFactStrip();
});
composePathInput.addEventListener('input', () => {
  composeManuallyEdited = Boolean(composePathInput.value.trim());
  invalidateMetadataRequest();
  if (
    !portManuallyEdited
    && (portSelectedFromDiscovery || containerPortInput.value === autoContainerPort)
  ) {
    containerPortInput.value = '';
    autoContainerPort = '';
  }
  portOptions.replaceChildren();
  portOptions.hidden = true;
  currentRepositoryMetadata = null;
  if (validRepositoryUrl(repositoryUrl.value.trim())) {
    scheduleRepositoryDiscovery(600);
  }
  syncFactStrip();
});
portOptions.addEventListener('change', () => {
  if (portOptions.value) {
    containerPortInput.value = portOptions.value;
    autoContainerPort = portOptions.value;
    portManuallyEdited = false;
    portSelectedFromDiscovery = true;
    syncFactStrip();
  }
});
composeOptions.addEventListener('change', () => {
  if (composeOptions.value) {
    composePathInput.value = composeOptions.value;
    composeManuallyEdited = true;
    invalidateMetadataRequest();
    if (
      !portManuallyEdited
      && (portSelectedFromDiscovery || containerPortInput.value === autoContainerPort)
    ) {
      containerPortInput.value = '';
      autoContainerPort = '';
    }
    portSelectedFromDiscovery = false;
    portOptions.replaceChildren();
    portOptions.hidden = true;
    currentRepositoryMetadata = null;
    if (validRepositoryUrl(repositoryUrl.value.trim())) {
      scheduleRepositoryDiscovery(600);
    }
    syncFactStrip();
  }
});
detectRepositoryButton.addEventListener('click', () => {
  if (metadataTimer !== null) {
    clearTimeout(metadataTimer);
    metadataTimer = null;
  }
  void discoverRepository({ force: true });
});
for (const eventName of ['change', 'blur']) {
  composePathInput.addEventListener(eventName, () => {
    if (validRepositoryUrl(repositoryUrl.value.trim())) {
      scheduleRepositoryDiscovery(0);
    }
  });
}
sidebarNavItems.forEach((item, itemIndex) => {
  item.addEventListener('click', (event) => {
    if (item.getAttribute('aria-disabled') === 'true') {
      event.preventDefault();
      return;
    }
    if (itemIndex === 0 && ['completed', 'failed', 'unknown'].includes(document.body.dataset.consoleState)) {
      event.preventDefault();
      newInspectionButton.click();
      return;
    }
    const target = itemIndex === 1 ? document.querySelector('#task-card') : document.querySelector('#report-card');
    if (itemIndex > 0 && target) {
      event.preventDefault();
      target.scrollIntoView({ block: 'start' });
    }
  });
});
form.addEventListener('submit', submitJob);
doctorButton.addEventListener('click', runDoctor);
discoverModelsButton.addEventListener('click', discoverModelList);
modelEndpointInput.addEventListener('input', () => {
  invalidateModelDiscovery();
});
modelApiKeyInput.addEventListener('input', () => {
  invalidateModelDiscovery();
});
modelNameToggle.addEventListener('click', () => {
  if (modelMenuOpen) closeModelMenu();
  else openModelMenu();
});
modelNameInput.addEventListener('input', () => {
  if (modelFetched) openModelMenu({ filter: modelNameInput.value });
});
modelNameInput.addEventListener('keydown', (event) => {
  if (event.key === 'ArrowDown') {
    event.preventDefault();
    if (!modelMenuOpen) openModelMenu();
    moveModelActive(1);
  } else if (event.key === 'ArrowUp') {
    event.preventDefault();
    if (!modelMenuOpen) openModelMenu();
    moveModelActive(-1);
  } else if (event.key === 'Enter' && modelMenuOpen) {
    const option = modelNameOptions.querySelectorAll('[role="option"]')[modelActiveIndex];
    if (option) {
      event.preventDefault();
      selectModelOption(option.textContent);
    }
  } else if (event.key === 'Escape') {
    closeModelMenu();
  }
});
document.addEventListener('click', (event) => {
  if (modelMenuOpen && !event.target.closest('.model-combobox')) closeModelMenu();
});
saveModelSettingsButton.addEventListener('click', saveModelSettings);
clearModelSettingsButton.addEventListener('click', clearModelSettings);
document.querySelector('#close-guide').addEventListener('click', () => {
  document.querySelector('#guide-dialog').close();
});
document.querySelectorAll('[data-guide]').forEach((link) => {
  link.addEventListener('click', (event) => {
    event.preventDefault();
    const dialog = document.querySelector('#guide-dialog');
    dialog.showModal();
    const section = document.querySelector('#guide-' + link.dataset.guide);
    section.scrollIntoView({ block: 'start' });
    section.focus({ preventScroll: true });
  });
});
document.querySelectorAll('#guide-dialog nav a').forEach((link) => {
  link.addEventListener('click', (event) => {
    event.preventDefault();
    const section = document.querySelector(link.getAttribute('href'));
    section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    section.focus({ preventScroll: true });
  });
});

language = readLanguage();
applyLanguage();
syncFactStrip();
if (startupReport) {
  renderDoctor(startupReport);
}
void loadModelSettings();

const storedJobId = readStoredJobId();
if (storedJobId) {
  activeJobId = storedJobId;
  recoverySummary = true;
  updateRunSummary();
  setBusy(true);
  void pollStatus();
}


retryButton.addEventListener('click', () => {
  if (retryButton.disabled) return;
  if (rerunRequestSnapshot) void submitJob({ preventDefault() {} }, rerunRequestSnapshot);
});
stopButton.addEventListener('click', () => {
  void stopActiveJob();
});
newInspectionButton.addEventListener('click', () => {
  if (newInspectionButton.disabled) return;
  resetInspection();
  rerunRequestSnapshot = null;
  form.reset();
  syncFactStrip();
  repositoryUrl.focus();
});
</script>
</body></html>

{% endif %}
