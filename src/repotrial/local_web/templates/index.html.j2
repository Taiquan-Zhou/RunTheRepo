<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="csrf-token" content="{{ csrf_token }}"><title>RunTheRepo · 本地控制台</title>
<style>
:root {
  --canvas:#f5f5f1; --surface:#fff; --surface-soft:#f0f3ee; --ink:#193a32;
  --muted:#66756f; --line:#d9e0d9; --brand:#c44732; --brand-soft:#fae8e2;
  --success:#187158; --warning:#9a681c; --danger:#b33b35; --radius-sm:8px; --radius-md:12px;
}
*,*::before,*::after { box-sizing:border-box; }
[hidden] { display:none!important; }
html { scroll-behavior:smooth; }
body { margin:0; background:var(--canvas); color:var(--ink); font:14px/1.55 "Ubuntu Sans","Segoe UI","PingFang SC","Microsoft YaHei","WenQuanYi Zen Hei",sans-serif; }
a { color:var(--brand); }
button,input,select { font:inherit; }
button { cursor:pointer; }
button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible,summary:focus-visible { outline:3px solid rgba(196,71,50,.28); outline-offset:3px; }
.topbar { min-height:58px; display:flex; align-items:center; justify-content:space-between; gap:20px; padding:10px clamp(18px,4vw,56px); background:var(--surface); border-bottom:1px solid var(--line); }
.brand { display:flex; align-items:center; gap:10px; color:var(--ink); font-size:16px; font-weight:750; letter-spacing:-.2px; }
.logo { display:grid; place-items:center; width:30px; height:30px; flex:0 0 30px; border-radius:8px; background:var(--brand); color:#fff; font-weight:800; }
.header-actions { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
.header-actions>a { color:var(--ink); font-weight:600; text-decoration:none; }
.pill { padding:4px 9px; border:1px solid var(--line); border-radius:999px; background:var(--surface-soft); color:var(--muted); font-size:12px; }
.language-label { color:var(--muted); font-size:12px; }
#language-select { width:auto; min-width:88px; min-height:34px; border:1px solid var(--line); border-radius:var(--radius-sm); padding:5px 8px; color:var(--ink); background:var(--surface); }
main { width:min(1200px,calc(100% - 40px)); margin:0 auto; padding:34px 0 44px; }
.workspace-intro { margin-bottom:24px; }
.workspace-intro h1 { margin:0; color:var(--ink); font-size:30px; line-height:1.15; letter-spacing:-.8px; }
.workspace-intro p { max-width:650px; margin:8px 0 0; color:var(--muted); }
.workspace-flow { display:flex; align-items:center; gap:0; margin:-8px 0 16px; color:var(--muted); font-size:12px; }
.flow-step { position:relative; display:flex; align-items:center; gap:7px; padding:6px 14px 6px 0; }
.flow-step:not(:last-child)::after { content:""; width:24px; height:1px; margin:0 10px; background:var(--line); }
.flow-step[aria-current="step"] { color:var(--ink); font-weight:750; }
.flow-step.is-done { color:var(--success); }
.flow-mark { width:7px; height:7px; border:1px solid currentColor; border-radius:50%; }
.workspace-surface { overflow:hidden; border:1px solid var(--line); border-radius:var(--radius-md); background:var(--surface); transition:opacity 160ms ease, transform 160ms ease; }
.console-grid { display:grid; grid-template-columns:minmax(0,2.05fr) minmax(280px,.95fr); gap:0; align-items:stretch; }
.card { min-width:0; border:0; border-radius:0; background:transparent; padding:22px; transition:opacity 160ms ease, transform 160ms ease; }
.card-header { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:20px; }
h2 { margin:0; color:var(--ink); font-size:16px; line-height:1.3; }
.section-kicker { margin:0 0 5px; color:var(--muted); font-size:12px; font-weight:650; }
.form-label-row,.field-label { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:7px; }
.field-label { justify-content:flex-start; }
.field-label > span:first-child { margin-right:auto; }
.card form>label,.card form details>label { display:flex; align-items:center; justify-content:flex-end; gap:8px; margin:0 0 7px; color:var(--ink); font-size:13px; font-weight:650; }
.card form>label>span:first-child,.card form details>label>span:first-child { margin-right:auto; }
.help { color:var(--muted); font-size:12px; font-weight:450; text-decoration:none; white-space:nowrap; }
.help:hover { color:var(--brand); }
input,select { width:100%; min-height:44px; border:1px solid #cbd5cd; border-radius:var(--radius-sm); padding:9px 11px; color:var(--ink); background:var(--surface); }
input:disabled,button:disabled,select:disabled { cursor:not-allowed; opacity:.58; }
small,.field-meta { color:var(--muted); font-size:12px; }
small { display:block; margin:5px 0 14px; }
.field-meta { display:flex; justify-content:space-between; gap:8px; min-height:16px; margin:-2px 0 5px; }
.model-key-row { display:flex; align-items:center; justify-content:space-between; gap:10px; margin:6px 0 8px; }
.model-key-row .field-meta { flex:1; margin:0; }
.model-settings-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:10px; }
.model-combobox { position:relative; }
.model-combobox input { padding-right:42px; }
.model-combobox-toggle { position:absolute; top:1px; right:1px; width:40px; height:42px; border:0; border-left:1px solid var(--line); border-radius:0 var(--radius-sm) var(--radius-sm) 0; background:var(--surface); color:var(--muted); }
.model-combobox-toggle:hover { background:var(--surface-soft); color:var(--ink); }
.model-listbox { position:absolute; z-index:5; top:calc(100% + 4px); left:0; right:0; max-height:220px; overflow:auto; border:1px solid var(--line); border-radius:var(--radius-sm); background:#fff; box-shadow:0 8px 20px rgba(23,34,56,.14); padding:4px; }
.model-listbox[hidden] { display:none; }
.model-option { padding:8px 10px; border-radius:6px; color:var(--ink); cursor:pointer; overflow-wrap:anywhere; }
.model-option:hover,.model-option[aria-selected="true"] { background:var(--brand-soft); color:var(--brand); }
.model-listbox-empty { padding:8px 10px; color:var(--muted); font-size:12px; }
.field-meta:empty,.field-meta:has(#commit-link[hidden]):has(#commit-source:empty) { display:none; }
.field-meta a { overflow-wrap:anywhere; }
.discovery-select { margin:3px 0 8px; }
.btn { display:inline-flex; align-items:center; justify-content:center; min-height:40px; border:1px solid transparent; border-radius:var(--radius-sm); padding:8px 14px; background:var(--brand); color:#fff; font-weight:700; text-decoration:none; }
.btn:hover { filter:brightness(.96); }
.btn.secondary { border-color:var(--line); background:var(--surface); color:var(--ink); }
.btn.secondary:hover { background:var(--surface-soft); }
.btn.wide { width:100%; margin-top:10px; }
details { margin-top:18px; border-top:1px solid var(--line); padding-top:14px; }
summary { cursor:pointer; color:var(--ink); font-weight:700; }
.environment-card { min-height:0; border-left:1px solid var(--line); background:var(--surface-soft); }
.environment-caption { color:var(--muted); font-size:12px; margin:4px 0 16px; }
.environment-empty { display:grid; place-items:center; min-height:110px; padding:15px; border:1px dashed var(--line); border-radius:var(--radius-sm); text-align:center; }
.environment-empty-visual svg { width:36px; height:36px; margin-bottom:4px; stroke:var(--muted); fill:none; stroke-width:1.5; }
.environment-empty p { margin:0; color:var(--muted); font-size:12px; }
.check { display:flex; justify-content:space-between; gap:12px; border-top:1px solid var(--line); padding:11px 0; }
.check-detail,.failure-details { margin:5px 0 12px; border:1px solid #eaded6; border-radius:var(--radius-sm); padding:10px 12px; background:#fffaf6; font-size:12px; overflow-wrap:anywhere; }
.check-detail.unsupported { background:#fffaf0; border-color:#eadfc6; }
.check-detail p,.failure-details p { margin:5px 0; color:var(--muted); }
.ok { color:var(--success); } .warn { color:var(--warning); } .error { color:var(--danger); }
#form-errors { color:var(--danger); margin-top:8px; }
#form-errors:empty { min-height:0; height:0; margin:0; }
.run-workspace { grid-column:1 / -1; border-left:3px solid var(--brand); }
.run-header { display:flex; justify-content:space-between; align-items:flex-start; gap:18px; margin-bottom:18px; }
.run-summary { color:var(--muted); font-size:13px; }
.run-summary strong { display:block; color:var(--ink); font-size:16px; }
.run-summary code { font:12px/1.4 ui-monospace,SFMono-Regular,Consolas,monospace; }
.run-state { display:flex; align-items:center; gap:8px; color:var(--muted); font-weight:700; white-space:nowrap; }
.dot { width:9px; height:9px; flex:0 0 9px; border-radius:50%; background:var(--muted); }
.status { display:flex; align-items:flex-start; gap:12px; margin-bottom:18px; border:1px solid var(--line); border-radius:var(--radius-sm); padding:16px; background:var(--surface-soft); }
.status strong { display:block; color:var(--ink); font-size:16px; }
.muted { color:var(--muted); }
.metrics { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin:14px 0; }
.metric { border-top:1px solid var(--line); padding-top:10px; }
.big { color:var(--ink); font-size:20px; font-weight:700; font-variant-numeric:tabular-nums; }
.detail { border-top:1px solid var(--line); padding-top:12px; color:var(--muted); overflow-wrap:anywhere; }
.phase-progress { margin-top:18px; border-top:1px solid var(--line); padding-top:16px; }
.phase-progress-title { color:var(--ink); font-size:13px; font-weight:700; }
.phase-list { display:grid; gap:4px; margin:9px 0 0; padding:0; list-style:none; }
.phase-list li { color:#a3ada7; font-size:12px; }
.phase-list li.confirmed { color:var(--success); } .phase-list li.current { color:var(--brand); font-weight:700; }
.latest-evidence { margin-top:10px; color:var(--muted); font-size:12px; }
.report-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:18px; }
.report-empty { display:grid; place-items:center; min-height:90px; color:var(--muted); }
.report-empty svg { width:42px; height:42px; stroke:var(--muted); fill:none; stroke-width:1.4; }
#report-card:has(#html-report:not([hidden])) .report-empty,#report-card:has(#json-report:not([hidden])) .report-empty { display:none; }
#config-card + #environment-card, #task-card + #report-card { border-left:1px solid var(--line); }
#task-card + #report-card { border-top:1px solid var(--line); border-left:0; }
.boundary-note { margin-top:20px; color:var(--muted); font-size:12px; }
.boundary-note strong { color:var(--ink); margin-right:8px; }
.run-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:20px; }
body[data-console-state="running"] #stop-button,body[data-console-state="submitting"] #stop-button { display:inline-flex; }
.activity { display:none; width:42px; height:4px; margin-top:8px; overflow:hidden; border-radius:999px; background:#d9e4df; }
.activity::after { content:""; display:block; width:45%; height:100%; border-radius:inherit; background:var(--brand); animation:activity-sweep 1.2s ease-in-out infinite; }
body[data-console-state="submitting"] .activity,body[data-console-state="running"] .activity { display:block; }
body[data-console-state="submitting"] .run-actions,body[data-console-state="running"] .run-actions { display:flex; }
@keyframes activity-sweep { 0% { transform:translateX(-100%); } 100% { transform:translateX(240%); } }
body[data-console-state="idle"] .run-workspace,body[data-console-state="idle"] #report-card,body[data-console-state="environment-checking"] .run-workspace,body[data-console-state="environment-checking"] #report-card { display:none; }
body[data-console-state="submitting"] #config-card,body[data-console-state="running"] #config-card,body[data-console-state="completed"] #config-card,body[data-console-state="failed"] #config-card,body[data-console-state="unknown"] #config-card { display:none; }
body[data-console-state="submitting"] #environment-card,body[data-console-state="running"] #environment-card,body[data-console-state="completed"] #environment-card,body[data-console-state="failed"] #environment-card,body[data-console-state="unknown"] #environment-card { display:none; }
body[data-console-state="submitting"] #report-card,body[data-console-state="running"] #report-card { display:none; }
body[data-console-state="completed"] #task-card,body[data-console-state="failed"] #task-card,body[data-console-state="unknown"] #task-card { grid-column:1; }
body[data-console-state="completed"] #report-card,body[data-console-state="failed"] #report-card,body[data-console-state="unknown"] #report-card { grid-column:2; }
body[data-console-state="submitting"] .run-workspace { display:block; }
body[data-console-state="submitting"] .run-workspace,body[data-console-state="running"] .run-workspace { grid-column:1 / -1; }
dialog { width:min(680px,calc(100vw - 30px)); max-height:85vh; border:1px solid var(--line); border-radius:var(--radius-md); padding:24px; color:var(--ink); }
dialog::backdrop { background:rgba(25,58,50,.28); }
dialog article { border-top:1px solid var(--line); padding:15px 0; }
dialog nav { display:flex; flex-wrap:wrap; gap:12px; margin:15px 0; }
@media (max-width:820px) { main { width:min(100% - 28px,680px); padding:26px 0 36px; } .console-grid { grid-template-columns:1fr; } .run-header { display:block; } .run-state { margin-top:12px; } }
@media (max-width:520px) { .topbar { align-items:flex-start; } .header-actions { justify-content:flex-end; gap:8px; } .header-actions .pill { display:none; } main { width:calc(100% - 24px); } .card { padding:17px; } .card form>label,.card form details>label { flex-wrap:wrap; justify-content:flex-start; } .help { margin-left:auto; } .metrics { grid-template-columns:1fr 1fr; } }
@media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } .activity::after { animation:none; transform:translateX(70%); } .workspace-surface,.card { transition:none; } }

/* v4 production refinement */
#task-card .run-layout { align-items:stretch; }
#task-card .run-primary { display:flex; flex-direction:column; }
#task-card .run-secondary { margin-top:auto; }
#task-card .run-events { grid-column:2; grid-row:1; }
body[data-console-state="completed"] #task-card,body[data-console-state="failed"] #task-card { grid-column:2; }
body[data-console-state="completed"] #task-card .run-layout,body[data-console-state="failed"] #task-card .run-layout { display:block; }
body[data-console-state="completed"] #report-card,body[data-console-state="failed"] #report-card { grid-column:1; grid-row:1; }
body[data-console-state="completed"] .console-grid,body[data-console-state="failed"] .console-grid,body[data-console-state="unknown"] .console-grid { align-items:start; }
body[data-console-state="unknown"] #report-card { display:none; }
body[data-console-state="unknown"] #task-card { grid-column:1 / -1; }
@media (max-width:820px) { body[data-console-state="completed"] #task-card,body[data-console-state="failed"] #task-card,body[data-console-state="completed"] #report-card,body[data-console-state="failed"] #report-card { grid-column:1; grid-row:auto; } }

:root { --canvas:#f4f5f8; --surface:#fff; --surface-soft:#f7f8fb; --ink:#172238; --muted:#6b7485; --line:#dfe3ea; --brand:#4b55d9; --brand-soft:#eef0ff; }
.btn { background:var(--brand); }
.btn.secondary:hover, #production-sidebar a[aria-current=page] { background:var(--brand-soft); color:var(--brand); }
button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible,summary:focus-visible { outline-color:rgba(75,85,217,.3); }
.workspace-eyebrow { margin:0 0 6px; color:var(--muted); font-size:12px; font-weight:700; letter-spacing:.02em; }
.state-badge { display:inline-flex; margin-top:8px; padding:3px 8px; border-radius:999px; background:var(--brand-soft); color:var(--brand); font-size:11px; font-weight:750; }
.environment-preflight { margin:0 0 14px; color:var(--muted); font-size:12px; }
.repo-context { display:flex; align-items:center; gap:9px; min-width:0; color:var(--ink); }
.repo-context-label { color:var(--muted); font-size:12px; }
.repo-context strong { max-width:300px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:14px; }
.menu-mark { color:var(--brand); font-size:18px; line-height:1; }
#fact-sha { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
#task-card { background:var(--surface); }
#task-card.run-workspace { border-left:0; }
#task-card .phase-progress { border:0; border-left:1px solid var(--line); margin:0; padding:22px; min-height:100%; background:#101827; color:#fff; }
#task-card .phase-progress-title { color:#fff; }
#task-card .phase-list li { color:#aeb9cc; }
#task-card .phase-list li.confirmed { color:var(--success); }
#task-card .phase-list li.current { color:#8f98ff; }
#task-card .run-primary { min-width:0; }
#task-card .run-events { min-width:0; }
#task-card .run-events-heading { color:#fff; font-size:13px; font-weight:750; }
#task-card .run-layout { display:grid; grid-template-columns:minmax(0,2fr) minmax(260px,1fr); }
#task-card .run-primary { padding:22px; }
#task-card .run-primary > .phase-progress { display:none; }
#task-card .run-events .phase-progress { display:block; }
#task-card .run-layout > .run-primary > .run-header { margin-top:0; }
body[data-console-state="running"] #task-card,body[data-console-state="submitting"] #task-card { grid-column:1 / -1; }
body[data-console-state="completed"] #task-card,body[data-console-state="failed"] #task-card,body[data-console-state="unknown"] #task-card { border-right:1px solid var(--line); }
@media (max-width:820px) { #task-card .run-layout { grid-template-columns:1fr; } #task-card .run-events { grid-column:1; grid-row:2; width:auto; } #task-card .run-events .phase-progress { border-left:0; border-top:1px solid #263247; min-height:0; } body[data-console-state="completed"] #task-card,body[data-console-state="failed"] #task-card,body[data-console-state="unknown"] #task-card,body[data-console-state="completed"] #report-card,body[data-console-state="failed"] #report-card,body[data-console-state="unknown"] #report-card { grid-column:1; } }

/* v4 product shell */
#production-sidebar{position:fixed;z-index:4;left:0;top:0;bottom:0;width:240px;padding:20px 15px;background:#fff;border-right:1px solid var(--line);color:var(--ink)}
#production-sidebar .side-brand{display:flex;align-items:center;gap:9px;padding:0 9px 28px;font-weight:800}
#production-sidebar .side-logo{width:30px;height:30px;border-radius:8px;display:grid;place-items:center;background:#4b55d9;color:#fff;font-weight:900}
#production-sidebar .side-label{padding:0 10px 10px;color:var(--muted);font-size:11px;font-weight:700}
#production-sidebar nav{display:grid;gap:4px}
#production-sidebar a{display:flex;align-items:center;gap:10px;padding:10px;border-radius:9px;color:var(--muted);text-decoration:none}
#production-sidebar a[aria-current=page]{background:#f0f1ff;color:#4b55d9;font-weight:800}
#production-sidebar .side-number{width:25px;height:25px;border-radius:7px;display:grid;place-items:center;background:#f1f3f6;font-size:11px;font-weight:800}
#production-sidebar a[aria-current=page] .side-number{background:#4b55d9;color:#fff}
#production-sidebar .side-help{position:absolute;left:15px;right:15px;bottom:20px;padding:14px 10px 0;border-top:1px solid var(--line);font-size:12px}
#fact-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:0 0 18px;border:1px solid var(--line);border-radius:12px;background:#fff}
#fact-strip .fact{min-width:0;padding:14px 16px;border-right:1px solid var(--line)}
#fact-strip .fact:last-child{border-right:0}
#fact-strip .fact-label{color:var(--muted);font-size:12px}
#fact-strip .fact-value{display:block;margin-top:6px;font-weight:750;overflow-wrap:anywhere}
#fact-strip .fact-state{display:block;margin-top:3px;color:var(--success);font-size:11px}
@media(min-width:821px){body{padding-left:240px}.topbar{margin-left:0}main{width:min(1200px,calc(100% - 40px))}}
@media(max-width:820px){ body{padding-left:0} #production-sidebar{position:static;width:auto;padding:10px 12px;border-right:0;border-bottom:1px solid var(--line)}#production-sidebar .side-brand{padding:0 5px 9px}#production-sidebar .side-label,#production-sidebar .side-help{display:none}#production-sidebar nav{display:flex;overflow:auto}#production-sidebar a{flex:1 0 auto;padding:8px}#fact-strip{grid-template-columns:repeat(2,minmax(0,1fr))}#fact-strip .fact:nth-child(2){border-right:0}#fact-strip .fact:nth-child(-n+2){border-bottom:1px solid var(--line)}}
</style>
</head>
<body data-console-state="idle"><aside id="production-sidebar"><div class="side-brand"><span class="side-logo">R</span><span>RunTheRepo</span></div><div class="side-label" data-i18n="nav.label">检查导航</div><nav aria-label="检查导航" data-i18n-aria-label="nav.aria"><a href="#config-card" aria-current="page"><span class="side-number">01</span><span data-i18n="nav.new">新建检查</span></a><a href="#task-card"><span class="side-number">02</span><span data-i18n="nav.current">当前任务</span></a><a href="#report-card"><span class="side-number">03</span><span data-i18n="nav.result">结果与证据</span></a></nav><div class="side-help"><span data-i18n="nav.help">帮助</span><br><a id="sidebar-guide" href="/?view=guide&lang=zh" target="_blank" rel="noopener" data-i18n="header.userGuide">使用文档 ↗</a></div></aside>
